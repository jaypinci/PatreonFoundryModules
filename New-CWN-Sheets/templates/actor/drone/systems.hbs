{{!-- ══════════════════════════════════════════════════════════════════════
  CWN DRONE SHEET — systems.hbs
  Tab: fittings, move type details
════════════════════════════════════════════════════════════════════════ --}}
<div class="cwn-tab tab" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  {{!-- ── FITTINGS ──────────────────────────────────────────────────────── --}}
  <div class="cwn-inventory-section">
    <div class="cwn-section-toggle-header"
         data-action="toggleSection"
         data-section-key="drone-fittings">
      <i class="fas fa-screwdriver-wrench"></i>
      <span>Fittings ({{shipFittings.length}})</span>
      {{#if editable}}
      <a class="cwn-add-inline" data-action="createDoc" data-document-class="Item" data-type="shipFitting" title="Add Fitting">
        <i class="fas fa-plus"></i>
      </a>
      {{/if}}
      <i class="fas fa-chevron-down section-chevron"></i>
    </div>
    <div class="cwn-section-content" data-section-content="drone-fittings">
      {{#if shipFittings}}
      <ol class="cwn-items-list items-list">
        <li class="cwn-items-header">
          <span class="col-img"></span>
          <span class="col-name">Name</span>
          <span class="col-dmg">Power</span>
          <span class="col-rng">Mass</span>
          <span class="col-controls"></span>
        </li>
        {{#each shipFittings as |fitting|}}
        <li class="cwn-item-row" data-item-id="{{fitting.id}}" data-document-class="Item" data-drag="true">
          <img class="col-img cwn-item-img" src="{{fitting.img}}" alt="{{fitting.name}}" width="22" height="22" />
          <span class="col-name cwn-item-name">
            <a data-action="toggleItemDescription" title="Expand">{{fitting.name}}</a>
          </span>
          <span class="col-dmg">{{fitting.system.power}}</span>
          <span class="col-rng">{{fitting.system.mass}}</span>
          <div class="col-controls cwn-row-controls">
            {{#if ../editable}}
            <a data-action="viewDoc" title="Edit"><i class="fas fa-edit"></i></a>
            <a data-action="deleteDoc" title="Delete"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
        {{#if fitting.system.enrichedDescription}}
        <li class="item-description-row hidden" data-item-id="{{fitting.id}}">
          <div class="cwn-item-desc">{{{fitting.system.enrichedDescription}}}</div>
        </li>
        {{/if}}
        {{/each}}
      </ol>
      {{else}}
      <p class="cwn-empty-hint">No fittings installed.</p>
      {{/if}}
    </div>
  </div>

  {{!-- ── STATS / PROFILE ──────────────────────────────────────────────── --}}
  <div class="cwn-inventory-section">
    <div class="cwn-section-toggle-header"
         data-action="toggleSection"
         data-section-key="drone-profile">
      <i class="fas fa-microchip"></i>
      <span>Drone Profile</span>
      <i class="fas fa-chevron-down section-chevron"></i>
    </div>
    <div class="cwn-section-content" data-section-content="drone-profile">
      <div class="cwn-npc-combat-info">

        <div class="cwn-npc-info-row">
          <span class="cwn-npc-info-label">Model</span>
          <span class="cwn-npc-info-value">{{modelDisplay}}</span>
        </div>

        <div class="cwn-npc-info-row">
          <span class="cwn-npc-info-label">Move Type</span>
          <span class="cwn-npc-info-value">{{cwnCapitalize system.moveType}}</span>
        </div>

        <div class="cwn-npc-info-row">
          <span class="cwn-npc-info-label">Speed</span>
          <input type="text" name="system.speed"
                 value="{{system.speed}}"
                 class="cwn-npc-info-input"
                 {{#unless editable}}disabled{{/unless}} />
        </div>

        <div class="cwn-npc-info-row">
          <span class="cwn-npc-info-label">Range</span>
          <input type="text" name="system.range"
                 value="{{system.range}}"
                 class="cwn-npc-info-input"
                 {{#unless editable}}disabled{{/unless}} />
        </div>

        <div class="cwn-npc-info-row">
          <span class="cwn-npc-info-label">Attack Bonus</span>
          <input type="text" name="system.attackBonus"
                 value="{{system.attackBonus}}"
                 class="cwn-npc-info-input"
                 placeholder="+2"
                 {{#unless editable}}disabled{{/unless}} />
        </div>

        <div class="cwn-npc-info-row">
          <span class="cwn-npc-info-label">Damage</span>
          <input type="text" name="system.damage"
                 value="{{system.damage}}"
                 class="cwn-npc-info-input"
                 placeholder="1d6"
                 {{#unless editable}}disabled{{/unless}} />
        </div>

        <div class="cwn-npc-info-row">
          <span class="cwn-npc-info-label">Pilot</span>
          {{#if pilot}}
          <a class="cwn-npc-info-value" data-action="openPilot" title="Open pilot sheet">
            {{pilot.name}}
          </a>
          {{else}}
          <span class="cwn-npc-info-value cwn-empty-hint" style="margin:0">Unassigned</span>
          {{/if}}
        </div>

      </div>
    </div>
  </div>

</div>{{!-- /.cwn-tab --}}
