{{!-- ══════════════════════════════════════════════════════════════════════
  CWN NPC SHEET — combat.hbs
  Tab: saves, attack block, skills, features, cyberware, pools
════════════════════════════════════════════════════════════════════════ --}}
<div class="cwn-tab tab" data-tab="{{tab.id}}" data-group="{{tab.group}}">
<div class="cwn-combat-layout cwn-npc-combat-layout">

  {{!-- ── LEFT: Saves & Skills ──────────────────────────────────────── --}}
  <section class="cwn-panel cwn-saves-panel">

    <header class="cwn-panel-header">
      <i class="fas fa-shield-halved"></i> Saves
    </header>
    <div class="cwn-saves-list">
      {{#each (array "physical" "evasion" "mental") as |saveKey|}}
      <div class="cwn-save-row">
        <button type="button"
                class="cwn-save-btn"
                data-action="rollSave"
                data-save-type="{{saveKey}}"
                title="Roll {{saveKey}} save">
          <i class="fas fa-dice-d20"></i>
          <span class="cwn-save-label">{{cwnCapitalize saveKey}}</span>
          <span class="cwn-save-target">{{../combatInfo.saves}}</span>
        </button>
      </div>
      {{/each}}
    </div>

    {{!-- Skills (always shown — Unskilled is always available) --}}
    <header class="cwn-panel-header" style="margin-top:12px">
      <i class="fas fa-brain"></i> Skills
    </header>
    <ol class="cwn-items-list items-list cwn-skills-list">

      {{!-- Unskilled: always present, rolls 2d6−1 --}}
      <li class="cwn-item-row cwn-unskilled-row">
        <i class="fas fa-question col-img" style="width:20px;text-align:center;line-height:20px;opacity:0.45"></i>
        <span class="col-name cwn-item-name">
          <a data-action="rollUnskilled" title="Roll Unskilled (2d6−1)">Unskilled</a>
        </span>
        <span class="cwn-skill-rank" style="opacity:0.5">−1</span>
        <div class="cwn-row-controls"></div>
      </li>

      {{#each skills as |skill|}}
      <li class="cwn-item-row" data-item-id="{{skill.id}}" data-document-class="Item">
        <img class="col-img cwn-item-img" src="{{skill.img}}" alt="{{skill.name}}" width="20" height="20" />
        <span class="col-name cwn-item-name">
          <a data-action="rollSkill" title="Roll {{skill.name}}">{{skill.name}}</a>
        </span>
        <span class="cwn-skill-rank">{{skill.system.rank}}</span>
        <div class="cwn-row-controls">
          {{#if ../editable}}
          <a data-action="skillUp" title="Increase rank"><i class="fas fa-arrow-up"></i></a>
          <a data-action="viewDoc" title="Edit"><i class="fas fa-edit"></i></a>
          <a data-action="deleteDoc" title="Delete"><i class="fas fa-trash"></i></a>
          {{/if}}
        </div>
      </li>
      {{/each}}
    </ol>
    {{#if editable}}
    <a class="cwn-add-btn" data-action="createDoc" data-document-class="Item" data-type="skill" title="Add Skill">
      <i class="fas fa-plus"></i> Add Skill
    </a>
    {{/if}}

  </section>

  {{!-- ── MIDDLE: Features & Cyberware ─────────────────────────────── --}}
  <section class="cwn-panel cwn-features-panel">

    {{!-- Features --}}
    <header class="cwn-panel-header">
      <i class="fas fa-star"></i> Features
      {{#if editable}}
      <a class="cwn-add-inline" data-action="createDoc" data-document-class="Item" data-type="feature" title="Add Feature">
        <i class="fas fa-plus"></i>
      </a>
      {{/if}}
    </header>
    {{#if features.length}}
    <ol class="cwn-items-list items-list">
      {{#each features as |feat|}}
      <li class="cwn-item-row" data-item-id="{{feat.id}}" data-document-class="Item" data-drag="true">
        <img class="col-img cwn-item-img" src="{{feat.img}}" alt="{{feat.name}}" width="20" height="20" />
        <span class="col-name cwn-item-name">
          <a data-action="toggleItemDescription" title="Expand">{{feat.name}}</a>
        </span>
        <div class="cwn-row-controls">
          {{#if ../editable}}
          <a data-action="viewDoc" title="Edit"><i class="fas fa-edit"></i></a>
          <a data-action="deleteDoc" title="Delete"><i class="fas fa-trash"></i></a>
          {{/if}}
        </div>
      </li>
      <li class="item-description-row hidden" data-item-id="{{feat.id}}">
        <div class="cwn-item-desc">
          {{#if feat.system.level}}
          <p style="margin:0 0 4px"><strong>Level {{feat.system.level}}</strong> {{#if feat.system.type}}<em style="opacity:0.6">({{feat.system.type}})</em>{{/if}}</p>
          {{/if}}
          {{#if feat.system.enrichedDescription}}
          {{{feat.system.enrichedDescription}}}
          {{else}}
          <span style="opacity:0.45;font-style:italic">No description — click the edit icon to add one.</span>
          {{/if}}
        </div>
      </li>
      {{/each}}
    </ol>
    {{else}}
    <p class="cwn-empty-hint">No features.</p>
    {{/if}}

    {{!-- Cyberware --}}
    {{#if cyberGroups.length}}
    <header class="cwn-panel-header" style="margin-top:12px">
      <i class="fas fa-microchip"></i> Cyberware
      {{#if editable}}
      <a class="cwn-add-inline" data-action="createDoc" data-document-class="Item" data-type="cyberware" title="Add Cyberware">
        <i class="fas fa-plus"></i>
      </a>
      {{/if}}
    </header>
    {{#each cyberGroups as |group|}}
    <div class="cwn-inventory-section cwn-cyber-group">
      <div class="cwn-section-toggle-header"
           data-action="toggleSection"
           data-section-key="cyber-{{group.key}}">
        <i class="fas {{group.icon}}"></i>
        <span>{{group.label}} ({{group.items.length}})</span>
        <i class="fas fa-chevron-down section-chevron"></i>
      </div>
      <div class="cwn-section-content" data-section-content="cyber-{{group.key}}">
        <ol class="cwn-items-list items-list">
          {{#each group.items as |cyber|}}
          <li class="cwn-item-row" data-item-id="{{cyber.id}}" data-document-class="Item" data-drag="true">
            <img class="col-img cwn-item-img" src="{{cyber.img}}" alt="{{cyber.name}}" width="20" height="20" />
            <span class="col-name cwn-item-name">
              <a data-action="toggleItemDescription" title="Expand">{{cyber.name}}</a>
            </span>
            <span class="cwn-cyber-strain">{{cyber.system.strain}} strain</span>
            <div class="cwn-row-controls">
              {{#if ../../editable}}
              <a data-action="viewDoc" title="Edit"><i class="fas fa-edit"></i></a>
              <a data-action="deleteDoc" title="Delete"><i class="fas fa-trash"></i></a>
              {{/if}}
            </div>
          </li>
          {{#if cyber.system.enrichedDescription}}
          <li class="item-description-row hidden" data-item-id="{{cyber.id}}">
            <div class="cwn-item-desc">{{{cyber.system.enrichedDescription}}}</div>
          </li>
          {{/if}}
          {{/each}}
        </ol>
      </div>
    </div>
    {{/each}}
    {{/if}}

  </section>

  {{!-- ── RIGHT: Pools ───────────────────────────────────────────────── --}}
  <section class="cwn-panel cwn-right-panel">

    {{#if hasAnyPools}}
    <header class="cwn-panel-header">
      <i class="fas fa-battery-three-quarters"></i> Resource Pools
    </header>
    <div class="cwn-pools-list">
      {{#each poolGroups as |group|}}
      <div class="cwn-pool-group">
        <div class="cwn-pool-group-name">{{group.resourceName}}</div>
        {{#each group.pools as |pool|}}
        <div class="cwn-pool-row {{#if pool.isEmpty}}empty{{/if}} {{#if pool.isLow}}low{{/if}}">
          <span class="cwn-pool-sub">{{pool.subResource}}</span>
          <div class="cwn-pool-track">
            <div class="cwn-pool-fill" style="width:{{pool.percentage}}%"></div>
          </div>
          <span class="cwn-pool-val">{{pool.current}}/{{pool.max}}</span>
        </div>
        {{/each}}
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{!-- NPC Attacks — sourced from readied weapons, same as the character sheet --}}
    <header class="cwn-panel-header" style="margin-top:12px">
      <i class="fas fa-crosshairs"></i> Attacks
    </header>

    {{#if readiedWeapons.length}}
    <ol class="cwn-npc-attacks-list">
      {{#each readiedWeapons as |weapon|}}
      <li class="cwn-attack-slot {{#if weapon.attackExpanded}}cwn-attack-expanded{{/if}}" data-item-id="{{weapon.id}}" data-document-class="Item" data-drag="true">
        <div class="cwn-attack-slot-header" data-action="toggleAttackDetails" data-item-id="{{weapon.id}}" title="Expand/collapse details">
          <img class="cwn-readied-img" src="{{weapon.img}}" alt="{{weapon.name}}" width="20" height="20" />
          <span class="cwn-attack-name-input">{{weapon.name}}</span>
          <button type="button" class="cwn-atk-roll-btn"
                  data-action="rollAttack" data-item-id="{{weapon.id}}"
                  title="Roll {{weapon.name}}">
            <i class="fas fa-dice-d20"></i>
          </button>
          <i class="fas fa-chevron-down cwn-attack-chevron"></i>
        </div>
        <div class="cwn-attack-details">
          <div class="cwn-attack-stats">
            <div class="cwn-npc-attack-row">
              <span class="cwn-npc-attack-label">Bonus</span>
              <span class="cwn-npc-attack-input">{{cwnMod weapon.system.ab}}</span>
            </div>
            <div class="cwn-npc-attack-row">
              <span class="cwn-npc-attack-label">Damage</span>
              <span class="cwn-npc-attack-input">{{weapon.system.damage}}</span>
            </div>
            <div class="cwn-npc-attack-row">
              <span class="cwn-npc-attack-label">Special</span>
              <input type="text"
                     class="cwn-npc-attack-input cwn-weapon-special-input"
                     data-item-id="{{weapon.id}}"
                     value="{{weapon.attackSpecial}}"
                     placeholder="Special info (posts to chat)…"
                     {{#unless ../editable}}disabled{{/unless}} />
            </div>
          </div>
          {{#if weapon.system.ammo}}
          <a data-action="reload" data-item-id="{{weapon.id}}" title="Reload" class="cwn-weapon-reload-link">
            <i class="fas fa-rotate-right"></i> Reload ({{weapon.system.ammo.value}}/{{weapon.system.ammo.max}})
          </a>
          {{/if}}
        </div>
      </li>
      {{/each}}
    </ol>
    {{else}}
    <p class="cwn-empty-hint">No readied weapons. Ready a weapon in the Gear tab to enable attacks.</p>
    {{/if}}

  </section>

</div>{{!-- /.cwn-npc-combat-layout --}}
</div>{{!-- /.cwn-tab --}}
