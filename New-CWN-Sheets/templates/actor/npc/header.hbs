{{!-- ══════════════════════════════════════════════════════════════════════
  CWN NPC SHEET — header.hbs
  Vendit-family aesthetic: ambient glows, threat ticker
════════════════════════════════════════════════════════════════════════ --}}

<div class="cwn-header-root cwn-npc-header-root">
<div class="cwn-glow-blob-l"></div>
<div class="cwn-glow-blob-r"></div>

<div class="cwn-header sheet-header">

  {{!-- Avatar --}}
  <div class="cwn-avatar-wrap">
    <img class="cwn-avatar"
         src="{{actor.img}}"
         alt="{{actor.name}}"
         data-edit="img"
         data-action="onEditImage"
         title="Click to change portrait" />
    <div class="cwn-avatar-overlay"><i class="fas fa-camera"></i></div>
  </div>

  {{!-- Identity --}}
  <div class="cwn-identity">
    <input class="cwn-name-input"
           type="text"
           name="name"
           value="{{actor.name}}"
           placeholder="DESIGNATION"
           {{#unless editable}}disabled{{/unless}} />

    <div class="cwn-identity-row">
      <label class="cwn-field-label">Type</label>
      <input type="text" name="system.faction"
             value="{{system.faction}}"
             placeholder="Gang, Corp, Beast…"
             {{#unless editable}}disabled{{/unless}} />

      <label class="cwn-field-label">HD</label>
      <input type="text" name="system.hitDice"
             value="{{system.hitDice}}"
             placeholder="2d8"
             {{#unless editable}}disabled{{/unless}} />
    </div>

    {{!-- Vitals --}}
    <div class="cwn-vitals">

      {{!-- HP --}}
      <div class="cwn-vital-group">
        <div class="cwn-vital-label">HP</div>
        <div class="cwn-resource-box">
          <input type="number" name="system.health.value"
                 value="{{system.health.value}}"
                 class="cwn-resource-val"
                 {{#unless editable}}disabled{{/unless}} />
          <span class="cwn-resource-sep">/</span>
          <input type="number" name="system.health.max"
                 value="{{system.health.max}}"
                 class="cwn-resource-max"
                 {{#unless editable}}disabled{{/unless}} />
        </div>
        <div class="cwn-resource-bar">
          <div class="cwn-resource-bar-fill hp-fill"
               style="width:{{cwnPercent system.health.value system.health.max}}%"></div>
        </div>
      </div>

      {{!-- AC --}}
      <div class="cwn-vital-group cwn-ac-group">
        <div class="cwn-vital-label">AC</div>
        <input type="number"
               value="{{system.baseAc}}"
               class="cwn-ac-value cwn-npc-stat-input cwn-header-field"
               data-header-field="system.baseAc"
               data-field-type="int"
               {{#unless editable}}disabled{{/unless}} />
        {{#if system.soak}}
        <div class="cwn-vital-label" style="margin-top:2px">Soak</div>
        <div class="cwn-resource-box" style="margin-top:2px">
          <input type="number" data-soak-field="value"
                 value="{{system.soak.value}}"
                 class="cwn-resource-val cwn-soak-input"
                 {{#unless editable}}disabled{{/unless}} />
          <span class="cwn-resource-sep">/</span>
          <input type="number" data-soak-field="max"
                 value="{{system.soak.max}}"
                 class="cwn-resource-max cwn-soak-input"
                 {{#unless editable}}disabled{{/unless}} />
        </div>
        <div class="cwn-resource-bar">
          <div class="cwn-resource-bar-fill soak-fill"
               style="width:{{cwnPercent system.soak.value system.soak.max}}%;background:{{cwnSoakColor system.soak.value system.soak.max}};box-shadow:0 0 6px {{cwnSoakColor system.soak.value system.soak.max}}"></div>
        </div>
        {{/if}}
      </div>

      {{!-- Skill Bonus --}}
      <div class="cwn-vital-group">
        <div class="cwn-vital-label">Skill</div>
        <input type="number"
               value="{{combatInfo.skillBonus}}"
               class="cwn-stat-badge cwn-npc-stat-input cwn-combat-info-input"
               data-combat-info-field="skillBonus"
               placeholder="+0"
               {{#unless editable}}disabled{{/unless}} />
      </div>

      {{!-- Save --}}
      <div class="cwn-vital-group">
        <div class="cwn-vital-label">Save</div>
        <input type="number"
               value="{{combatInfo.saves}}"
               class="cwn-stat-badge cwn-npc-stat-input cwn-combat-info-input"
               data-combat-info-field="saves"
               {{#unless editable}}disabled{{/unless}} />
      </div>

      {{!-- Morale --}}
      <div class="cwn-vital-group">
        <div class="cwn-vital-label">Morale</div>
        <input type="number"
               value="{{combatInfo.moralScore}}"
               class="cwn-stat-badge cwn-npc-stat-input cwn-combat-info-input"
               data-combat-info-field="moralScore"
               min="2" max="12"
               {{#unless editable}}disabled{{/unless}} />
      </div>

    </div>{{!-- /.cwn-vitals --}}

    {{!-- Action buttons --}}
    <div class="cwn-header-actions">
      <button type="button" data-action="rollHitDice" title="Roll Max HP">
        <i class="fas fa-dice-d8"></i> Roll HP
      </button>
      <button type="button" data-action="rollMorale" title="Morale Check">
        <i class="fas fa-flag"></i> Morale
      </button>
      <button type="button" data-action="scene" title="End of Scene">
        <i class="fas fa-hourglass-end"></i> Scene
      </button>
      <button type="button" data-action="roll" data-roll-type="attack" title="Attack">
        <i class="fas fa-crosshairs"></i> Attack
      </button>
      <button type="button" data-action="toggleLock" class="cwn-lock-btn" title="Toggle Edit Lock">
        <i class="fas fa-lock lock-indicator"></i>
      </button>
    </div>

  </div>{{!-- /.cwn-identity --}}

  {{!-- Threat ticker --}}
  <div class="cwn-header-ticker-outer">
    <div class="cwn-header-ticker">
      <span>THREAT PROFILE LOADED</span>
      <span>HOSTILE ENTITY — ENGAGE WITH CAUTION</span>
      <span>MORALE RATING: {{combatInfo.moralScore}}</span>
      <span>CLEARANCE REQUIRED FOR FULL DOSSIER</span>
      <span>TARGET ACQUIRED — STAY FROSTY</span>
      <span>THREAT PROFILE LOADED</span>
      <span>HOSTILE ENTITY — ENGAGE WITH CAUTION</span>
      <span>MORALE RATING: {{combatInfo.moralScore}}</span>
      <span>CLEARANCE REQUIRED FOR FULL DOSSIER</span>
      <span>TARGET ACQUIRED — STAY FROSTY</span>
    </div>
  </div>

</div>{{!-- /.cwn-header --}}
</div>{{!-- /.cwn-header-root --}}
