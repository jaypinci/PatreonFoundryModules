{{!-- ══════════════════════════════════════════════════════════════════════
  CWN CHARACTER SHEET — cyberware.hbs
  Tab: system strain summary + body-part grouped cyberware
════════════════════════════════════════════════════════════════════════ --}}
<div class="cwn-tab tab" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <div class="cwn-tab-header">
    <h2 class="cwn-section-title"><i class="fas fa-microchip"></i> Cyberware</h2>
    {{#if editable}}
    <a class="cwn-add-btn"
       data-action="createDoc"
       data-document-class="Item"
       data-type="cyberware"
       title="Add Cyberware">
      <i class="fas fa-plus"></i> Add
    </a>
    {{/if}}
  </div>

  {{!-- Strain summary --}}
  <div class="cwn-strain-summary">
    <div class="cwn-strain-row">
      <span class="cwn-strain-label">System Strain</span>
      <div class="cwn-resource-bar cwn-strain-bar-wrap">
        <div class="cwn-resource-bar-fill cwn-strain-bar-fill"
             style="width:{{cwnPercent system.systemStrain.value system.systemStrain.max}}%"></div>
      </div>
      <span class="cwn-strain-value">
        {{system.systemStrain.value}} / {{system.systemStrain.max}}
      </span>
    </div>
    <div class="cwn-strain-breakdown">
      <span>Cyberware strain: <strong>{{system.systemStrain.cyberware}}</strong></span>
      <span>Permanent: <strong>{{system.systemStrain.permanent}}</strong></span>
    </div>
  </div>

  {{!-- Per-location sections --}}
  {{#each cyberGroups as |group|}}
  <div class="cwn-cyber-section" data-location="{{group.key}}">

    <div class="cwn-section-toggle-header"
         data-action="toggleSection"
         data-section-key="cyber-{{group.key}}">
      <i class="fas {{group.icon}} cwn-body-icon"></i>
      <span class="cwn-location-label">{{group.label}}</span>
      <span class="cwn-location-count">{{group.items.length}} implant{{#if (cwnGt group.items.length 1)}}s{{/if}}</span>
      <i class="fas fa-chevron-down section-chevron"></i>
    </div>

    <div class="cwn-section-content" data-section-content="cyber-{{group.key}}">
      <ol class="cwn-items-list cwn-cyber-list items-list">
        <li class="cwn-items-header">
          <span class="col-img"></span>
          <span class="col-name">Implant</span>
          <span class="col-dmg">Strain</span>
          <span class="col-controls"></span>
        </li>
        {{#each group.items as |cyb|}}
        <li class="cwn-item-row cwn-cyber-row"
            data-item-id="{{cyb.id}}"
            data-document-class="Item"
            data-searchable-row>
          <img class="col-img cwn-item-img" src="{{cyb.img}}" alt="{{cyb.name}}" width="22" height="22" />
          <div class="col-name">
            <span class="cwn-item-name" data-item-name="{{cyb.name}}">{{cyb.name}}</span>
            {{#if cyb.system.description}}
            <a data-action="toggleItemDescription" title="Show description">
              <i class="fas fa-info-circle"></i>
            </a>
            {{/if}}
          </div>
          <span class="col-dmg cwn-strain-badge">⚡ {{cyb.system.strain}}</span>
          <div class="col-controls cwn-row-controls">
            {{#if ../../editable}}
            <a data-action="viewDoc" title="Edit"><i class="fas fa-edit"></i></a>
            <a data-action="deleteDoc" title="Delete"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
        {{#if cyb.system.description}}
        <li class="item-description-row hidden" data-item-id="{{cyb.id}}">
          {{{cyb.system.enrichedDescription}}}
        </li>
        {{/if}}
        {{/each}}
      </ol>
    </div>

  </div>
  {{/each}}

  {{#unless cyberGroups}}
  <p class="cwn-empty-hint">No cyberware installed yet.</p>
  {{/unless}}

</div>{{!-- /.cwn-tab --}}
